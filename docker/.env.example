# ==========================================================================
# Salin ke docker/.env lalu sesuaikan. Dipakai oleh docker-compose.yml.
#   cp docker/.env.example docker/.env
# Berkas .env JANGAN di-commit (sudah ada di .gitignore).
# ==========================================================================

TZ=Asia/Jakarta

# Password admin panel (halaman /admin). Kosongkan untuk dibuat acak otomatis;
# hasilnya tertulis di /var/lib/antrianahass/ADMIN-PASSWORD.txt dalam volume
# (baca dengan: docker exec ahass-panel cat /var/lib/antrianahass/ADMIN-PASSWORD.txt)
AHASS_ADMIN_PASSWORD=

# Alamat server DDMS (bisa diubah lagi dari halaman admin).
AHASS_DDMS_URL=https://web-h2-cbr.daya-dms.id

# IP perangkat yang ditampilkan di layar untuk STB/PC lain.
# Kosongkan bila memakai network_mode: host (terdeteksi otomatis).
AHASS_DISPLAY_IP=

# --- kiosk (profil "kiosk") ---
# URL yang dibuka Chromium; 127.0.0.1 benar karena kiosk memakai network host.
AHASS_URL=http://127.0.0.1:8080/
DISPLAY=:0
SCREEN_W=1920x1080x24
# 1 = layar virtual di dalam container (tanpa TV/X host).
AHASS_XVFB=0

# --- image (biarkan bawaan, atau arahkan ke registry sendiri) ---
#AHASS_IMAGE=ghcr.io/nhs-den/antrianahass:latest
#AHASS_KIOSK_IMAGE=ghcr.io/nhs-den/antrianahass-kiosk:latest
# Raspberry Pi 3 B+ (armv7): bangun kiosk dengan base armhf
#AHASS_KIOSK_BASE=arm32v7/debian:bookworm-slim
