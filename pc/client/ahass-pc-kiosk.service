[Unit]
Description=Panel AHASS - Chromium kiosk menampilkan panel PC (STB client)
Documentation=file:///opt/antrianahass/pc/README.md
# STB tidak menjalankan server apa pun; yang ditunggu hanya jaringan.
After=network-online.target systemd-user-sessions.service
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=__KIOSK_USER__
Group=__KIOSK_USER__
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ahass-pc-kiosk
Environment=AHASS_PANEL_URL=__PANEL_URL__
Environment=AHASS_PROFILE_DIR=__PROFILE_DIR__
Environment=XDG_RUNTIME_DIR=/run/ahass-pc-kiosk
Environment="CHROMIUM_FLAGS=__CHROMIUM_FLAGS__"
RuntimeDirectory=ahass-pc-kiosk
RuntimeDirectoryMode=0755
# Tunggu PC menjawab /__ahass/api/health agar tidak muncul halaman putih.
ExecStartPre=/usr/local/bin/ahass-pc-wait-panel.sh
ExecStart=/usr/bin/xinit /usr/local/bin/ahass-pc-kiosk.sh -- :0 vt1 -nolisten tcp -nocursor
Restart=always
RestartSec=5
# 120 s tunggu PC + waktu start Chromium.
TimeoutStartSec=240

[Install]
WantedBy=multi-user.target
